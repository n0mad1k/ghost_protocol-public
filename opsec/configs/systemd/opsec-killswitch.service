[Unit]
Description=OPSEC Kill Switch (fail closed: Tor only)
Before=NetworkManager.service
Before=networking.service
After=local-fs.target
ConditionPathExists=/etc/opsec/boot-advanced.enabled

[Service]
Type=oneshot
ExecStart=/usr/local/bin/opsec-killswitch.sh strict-on
ExecStop=/usr/local/bin/opsec-killswitch.sh strict-off
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
